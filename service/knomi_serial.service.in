[Unit]
Description=Knomi_Serial display watcher
Documentation=https://github.com/Vylyne/knomi_serial
# Deliberately not After=klipper.service or Requires=. The whole point of this
# is to know which display is on which port when Klipper is *not* running -
# that is when a display gets flashed, and a port has to be free to be flashed.
After=network.target

[Service]
Type=simple
# Same user as Klipper, so the map it writes is readable by the module without
# anything having to be world-writable, and so it inherits the group that grants
# access to the serial ports.
User=@USER@
Group=@USER@
# Through service/run.sh rather than straight at python, because this file can
# only be rewritten by install.sh with root, while run.sh is updated by the same
# `git pull` that updates everything else. Anything about how the watcher starts
# that might change later belongs there, not here.
#
# Invoked via /bin/sh rather than relying on run.sh being executable: the repo
# is developed on a filesystem with no exec bit, and a lost one here is a
# 203/EXEC that only ever shows up on a printer.
ExecStart=/bin/sh @REPO@/service/run.sh
# Otherwise the journal tags every line `sh`, because systemd takes the
# identifier from ExecStart's basename and never looks again - not even after
# run.sh execs into python. Which makes `journalctl -t` useless and makes the
# service look like it failed to exec when it did.
SyslogIdentifier=knomi_serial
Restart=always
RestartSec=5

# It reads serial ports and writes one file. Nothing else is needed.
#
# Do not add PrivateNetwork=yes or a RestrictAddressFamilies= without
# AF_NETLINK. The watcher learns about ports from udev over a netlink socket,
# and either of those leaves it starting cleanly and then never hearing an
# event again - a silent failure of the same shape as the ReadWritePaths one
# install.sh warns about. ProtectSystem=strict is fine: it leaves /dev, /proc
# and /sys alone, and uevent multicast needs no privilege.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA@

[Install]
WantedBy=multi-user.target
